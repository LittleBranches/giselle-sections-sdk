{
  "name": "@littlebranches/giselle-sections-sdk",
  "version": "0.3.0",
  "description": "Pure, type-safe data factories for React/Next.js section-based UIs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node scripts/setup-hooks.cjs && npm run build",
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "banned-content": "node scripts/check-banned-content.js",
    "prepack": "npm run build 1>&2",
    "changeset": "changeset"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LittleBranches/giselle-sections-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/LittleBranches/giselle-sections-sdk/issues"
  },
  "homepage": "https://github.com/LittleBranches/giselle-sections-sdk#readme",
  "keywords": [
    "react",
    "nextjs",
    "typescript",
    "sections",
    "data-layer",
    "portfolio"
  ],
  "author": "Alex Rebula",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/react": "^19.2.14",
    "react": "^19.2.0",
    "tsup": "^8.5.1",
    "typescript": "5.9",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  }
}
